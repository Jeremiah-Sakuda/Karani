# Karani environment — every variable the system will ever read.
#
# `make demo` reads NONE of these. The offline demo path runs with zero credentials
# by design (KAR-501); if you find yourself needing a value here to run `make demo`,
# that is a bug in the demo path, not a missing variable.
#
# Copy to `.env` and fill in only for `make demo-live` and deployed runs.

# ---------------------------------------------------------------------------
# Google Cloud project and location
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=asili-xprize-2026
GOOGLE_CLOUD_LOCATION=global
# Vertex AI is the runtime model surface. "true" routes the GenAI SDK at Vertex
# rather than the public Gemini API. Karani only supports the Vertex path.
GOOGLE_GENAI_USE_VERTEXAI=true

# ---------------------------------------------------------------------------
# Model pinning (KAR-301, KAR-503)
# Pinned ID strings, never aliases. A model alias silently changes what produced
# an observation, which makes provenance{} a lie.
# ---------------------------------------------------------------------------
KARANI_MODEL_ANALYSIS=gemini-3.5-pro
KARANI_MODEL_VERIFY=gemini-3.5-flash
KARANI_MODEL_TRIAGE=gemma-3-4b-it
# Temperature is pinned to 0 in code and recorded in provenance{}. It is not
# configurable by environment: a run whose temperature came from the shell is
# not reproducible.

# ---------------------------------------------------------------------------
# Firestore / event log
# ---------------------------------------------------------------------------
# Backend selection: "local" (file-backed, zero credentials — the demo default),
# "emulator" (Firestore emulator, needs Java), or "firestore" (deployed).
KARANI_STORE_BACKEND=local
KARANI_LOCAL_STORE_DIR=.karani/store
FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Ingest and delivery
# ---------------------------------------------------------------------------
KARANI_SOURCE=local
KARANI_SOURCE_DIR=fixtures
# GCS bucket used only for the object-finalize trigger (KAR-319) on the deployed path.
KARANI_INGEST_BUCKET=
# Delivery target: the single Drive folder the delivery SA may write to (KAR-406).
KARANI_DELIVERY_DRIVE_FOLDER_ID=
KARANI_DELIVERY_MODE=local

# ---------------------------------------------------------------------------
# Model Armor (KAR-311)
# ---------------------------------------------------------------------------
# Template resource name created by scripts/bootstrap_gcp.sh. If the managed API is
# unavailable on this account tier, leave empty: the scan runs under its own name
# with an honest offline label and the finding is recorded in docs/FINDINGS.md.
KARANI_ARMOR_TEMPLATE=

# ---------------------------------------------------------------------------
# Response cache (KAR-301)
# Durable and shared, never in-process: idempotency depends on a worker retried at
# the same attempt number regenerating byte-identical text.
# ---------------------------------------------------------------------------
KARANI_CACHE_DIR=fixtures/cache
KARANI_CACHE_BACKEND=file

# ---------------------------------------------------------------------------
# Run bounds (KAR-307, KAR-314)
# ---------------------------------------------------------------------------
KARANI_MAX_ATTEMPTS=2
KARANI_T_MAX_SECONDS=1200
KARANI_MAX_TOTAL_ATTEMPTS=400
KARANI_MAX_WALL_CLOCK_SECONDS=2400

# ---------------------------------------------------------------------------
# Docket service
# ---------------------------------------------------------------------------
KARANI_DOCKET_PORT=8080
KARANI_GOLDEN_LOG=fixtures/golden-log.jsonl
