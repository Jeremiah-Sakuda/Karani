rules_version = '2';

// Firestore rules cover the BROWSER path only.
//
// Stating that plainly matters, because rules are frequently mistaken for the whole story.
// A service account using the server SDK does not evaluate these rules at all — it is
// authorised by IAM. So the append-only guarantee and the grades boundary are each enforced
// twice, by two different mechanisms, because each mechanism covers a path the other does not:
//
//   browser / client SDK  ->  these rules
//   service account       ->  the custom IAM role in deploy/iam/karani-append-only.yaml
//
// KAR-102 and KAR-312 assert both. An emulator test proves the client surface; a deployed
// integration test proves the service-account surface receives PERMISSION_DENIED. Either one
// alone would leave a door open while looking complete.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------------
    // The event log. Append-only, and that means create-only.
    // ---------------------------------------------------------------------------------
    match /runs/{runId} {
      allow read: if true;
      allow write: if false;

      match /events/{eventId} {
        allow read: if true;
        // Create is permitted; update and delete are not, ever, by anyone on this path.
        // Deterministic event IDs mean a duplicate create fails on ALREADY_EXISTS, which the
        // application turns into either a self-dedupe (identical content) or an
        // EventIdCollision (differing content). Neither is a silent overwrite.
        allow create: if true;
        allow update, delete: if false;
      }

      // Rendered artifacts are written by render() through a service account, never here.
      match /artifacts/{artifactId} {
        allow read: if true;
        allow write: if false;
      }

      match /claims/{claimId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------------------
    // There is deliberately NO grades block in this file.
    // ---------------------------------------------------------------------------------
    //
    // This file guards the EVENTS database. A `match /grades/{...}` block used to sit here,
    // allowing authenticated-human writes -- a leftover from the abandoned single-database
    // design, and a shadow grades path: a browser session could have written grade-shaped
    // documents into the events database, where nothing legitimate would ever read them but
    // where their existence alone would falsify "grades live in exactly one place." An
    // external review caught it as the one spot where this repo's discipline slipped.
    //
    // Grades have exactly one home: the karani-grades database, guarded by
    // deploy/firestore-grades.rules. In THIS database, grades fall through to the default
    // deny below -- unreachable from a browser for the same reason they are unreachable
    // from a pipeline service account.

    // Default deny. Anything not named above is unreachable rather than accidentally open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
